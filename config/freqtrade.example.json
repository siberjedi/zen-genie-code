{
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 100,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "spot",
  "margin_mode": "isolated",
  "unfilledtimeout": { "entry": 10, "exit": 10, "exit_timeout_count": 0, "unit": "minutes" },
  "entry_pricing": { "price_side": "same", "use_order_book": false, "order_book_top": 1, "price_last_balance": 0.0, "check_depth_of_market": { "enabled": false, "bids_to_ask_delta": 1 } },
  "exit_pricing": { "price_side": "same", "use_order_book": false, "order_book_top": 1 },
  "exchange": {
    "name": "binance",
    "pair_whitelist": [],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "VolumePairList",
      "number_assets": 30,
      "sort_key": "quoteVolume",
      "min_value": 5000000,
      "refresh_period": 1800
    },
    { "method": "AgeFilter", "min_days_listed": 10 },
    { "method": "PrecisionFilter" },
    { "method": "PriceFilter", "low_price_ratio": 0.01 },
    { "method": "SpreadFilter", "max_spread_ratio": 0.005 },
    { "method": "VolatilityFilter", "lookback_days": 3, "min_volatility": 0.01, "max_volatility": 0.9, "refresh_period": 86400 }
  ],
  "bot_name": "ai-trader-dryrun",
  "initial_state": "running",
  "db_url": "sqlite:///user_data/tradesv3.dryrun.sqlite",
  "loglevel": "info"
}
